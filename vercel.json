{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@ffmpeg-installer/**"
    },
    "api/of-webhook.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@ffmpeg-installer/**,assets/**}"
    },
    "api/welcome.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@ffmpeg-installer/**,assets/**}"
    },
    "api/ppv-cron.ts": {
      "maxDuration": 60
    },
    "api/daily-report.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "0 19 * * *"
    }
  ]
}
